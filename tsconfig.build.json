{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "noEmit": false
  },
  "include": ["src/core/**/*", "src/server/**/*", "src/nestjs/**/*", "src/react/**/*", "src/fastify/**/*"],
  "exclude": ["**/*.spec.ts", "**/__tests__/**"]
}
